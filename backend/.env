# ============================================================
# MTN MoMo Loan – South Africa – Production Environment
# ============================================================

# ─── REQUIRED ───
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Webhook secret (generate a random string — Telegram uses it to authenticate calls)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=change_me_to_a_random_64_char_hex_string

# ─── OPTIONAL ───
PORT=3000
NODE_ENV=production

# Rate limits
RATE_LIMIT_APPLICATIONS_PER_PHONE_PER_DAY=3
RATE_LIMIT_APPLICATIONS_PER_IP_PER_HOUR=10
RATE_LIMIT_TELEGRAM_PER_CHAT_PER_HOUR=100

# Data retention
DATA_RETENTION_DAYS=30
